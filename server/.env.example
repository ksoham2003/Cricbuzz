# Server Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (e.g. local mongodb or MongoDB Atlas URI)
MONGO_URL=mongodb://localhost:27017/cricbuzzDB

# CORS Setup (Comma-separated URLs allowed to connect to backend)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate Limit Config
RATELIMIT_WINDOWMS=900000
RATELIMIT=100

# Security (JWT secrets)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Google OAuth (Must register app in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Post-Login Redirection Target (Client URL)
REDIRECT_URL=http://localhost:5173
